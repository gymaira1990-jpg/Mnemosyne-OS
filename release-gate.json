{
  "project": "Mnemosyne-OS",
  "_comment": "发布流程门禁配置（七阶段 P0~P6，权威标准见 gcat-std/RELEASE-FLOW.md）。命令以 argv 列表执行（shlex.split，不过 shell）——见 gcat-std 红线。⚠️ 不含 repo 字段（本机路径属隐私红线）：运行时用 `--repo <路径>` 传入。",
  "stages": {
    "P0": {
      "gate": "方案：PRD + 判据表 + 不做清单 + 任务拆分表",
      "commands": [
        {
          "name": "方案要件（判据表 + 不做清单）",
          "run": "python3 scripts/release_checks.py plan openspec/changes/2026-09-25-v8-memory-os/proposal.md"
        }
      ]
    },
    "P1": {
      "gate": "工作区开发：改动落地 + 独立 commit（严禁碰正式环境/远端）",
      "commands": [
        {
          "name": "工作区已提交（无未提交改动）",
          "run": "git diff --quiet HEAD"
        }
      ]
    },
    "P2": {
      "gate": "本地测试：全量绿 + 反证 + 契约",
      "commands": [
        {
          "name": "全量用例",
          "run": ".venv/bin/python -m pytest tests/ -q",
          "timeout": 600
        },
        {
          "name": "分层规格自检",
          "run": ".venv/bin/python core/layers.py --self-check"
        },
        {
          "name": "回收作业干跑",
          "run": ".venv/bin/python jobs/compaction.py --dry-run --dsn postgresql:///mnemosyne_v8test --limit 50"
        }
      ]
    },
    "P3": {
      "gate": "部署：备份可恢复 + 最小覆盖 + 服务自报版号 + 回滚演练",
      "commands": [
        {
          "name": "服务自报版号 == 仓库 VERSION",
          "run": "python3 scripts/release_checks.py service-version http://127.0.0.1:18010/"
        }
      ]
    },
    "P4": {
      "gate": "正式环境测试：真链路实测 + 真实数据核验 + 测试件清场",
      "commands": [
        {
          "name": "正式环境冒烟（分层写入四发验证 + 落库 + 清场）",
          "run": ".venv/bin/python scripts/prod_smoke.py http://127.0.0.1:18010",
          "timeout": 300
        }
      ]
    },
    "P5": {
      "gate": "发布：版本三处一致 + 隐私零输出 + 独立 clone 复扫 + 开源就绪",
      "commands": [
        {
          "name": "版本一致性",
          "run": "python3 scripts/release_checks.py version-consistency"
        },
        {
          "name": "隐私扫描",
          "run": "python3 scripts/release_checks.py privacy"
        }
      ]
    },
    "P6": {
      "gate": "归纳：CHANGELOG + 指针回链 + 记忆 + 台账 + 交付三件套",
      "commands": [
        {
          "name": "CHANGELOG 含版本",
          "run": "python3 scripts/release_checks.py changelog 8.0.0"
        }
      ]
    }
  }
}
