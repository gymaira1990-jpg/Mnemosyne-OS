{
  "_comment": "部署指纹清单。deploy=运行面必须一致；prod_only=生产合法独有；known_diff=已知欠账(必须 why+until)。改这张表 = 改判据，别为了变绿而加条目。",
  "remote": "gz",
  "path": "/opt/mnemosyne",
  "deploy": [
    "VERSION",
    "api/*.py",
    "api/agents.py",
    "config.py",
    "constraints.txt",
    "core/*.py",
    "core/conflict.py",
    "cron/*.sh",
    "deploy/mnemosyne.service",
    "docs/schema.sql",
    "drawer_pipeline.py",
    "drawer_report.py",
    "integrations/*.py",
    "integrations/hermes-client/*.py",
    "integrations/hermes-mcp/*.py",
    "jobs/*.py",
    "main.py",
    "memory_tokenize.py",
    "palace.py",
    "perf_alert.py",
    "reflector.py",
    "requirements.txt",
    "scripts/archive_session.py",
    "scripts/backfill_embeddings.py",
    "scripts/backup.sh",
    "scripts/bootstrap.sh",
    "scripts/card_check.py",
    "scripts/conflict_scan.py",
    "scripts/context_pack.py",
    "scripts/doctor.py",
    "scripts/eval_recall.py",
    "scripts/labels_to_cases.py",
    "scripts/prod_smoke.py",
    "scripts/register_projects.py",
    "scripts/release_checks.py",
    "scripts/report_card.py",
    "scripts/seed_demo.py",
    "scripts/version-scan.sh",
    "security/*.py",
    "skill_sync.py",
    "skill_tokenize.py",
    "sync/*.py",
    "tmt/*.py",
    "wiki/*.py"
  ],
  "prod_only": [
    {
      "glob": "diary_daily.py",
      "why": "日记生成作业：源头在 diary-book 私有仓，不上公开仓"
    },
    {
      "glob": "jobs/backfill_entities.py",
      "why": "私有回灌作业：源头在 diary-book 仓"
    },
    {
      "glob": "jobs/export_diary_data.py",
      "why": "私有导出作业：源头在 diary-book 仓"
    },
    {
      "glob": "jobs/forget_report.py",
      "why": "私有漏卡巡检：源头在 diary-book 仓"
    },
    {
      "glob": "jobs/steward_dedupe.py",
      "why": "私有判重作业：源头在 diary-book 仓"
    },
    {
      "glob": "jobs/steward_polish.py",
      "why": "私有精修作业：源头在 diary-book 仓"
    },
    {
      "glob": "__init__.py",
      "why": "生产根目录包标记（历史遗留，无副作用）"
    },
    {
      "glob": "*.sh",
      "why": "生产根目录的调度脚本：源头在仓库 cron/，但历史布局落在根目录（见 known_diff 的 same-path 欠账）"
    },
    {
      "glob": ".pre-deploy-*/*",
      "why": "部署前快照副本（回滚用），不是运行代码"
    },
    {
      "glob": ".stage-*/*",
      "why": "部署暂存副本，不是运行代码"
    },
    {
      "glob": "scripts/lme-eval-pilot*.py",
      "why": "一次性评测试验脚本，未入库"
    },
    {
      "glob": "tests/*.py",
      "why": "生产上保留少量旧测试副本（历史部署残留），非运行代码；仓库 tests/ 才是权威"
    },
    {
      "glob": ".backup-*/*",
      "why": "部署前快照（本次 2026-11-07 部署建的），回滚用"
    }
  ],
  "known_diff": [],
  "path_map": {
    "cron/check-mnemosyne-health.sh": "check-mnemosyne-health.sh",
    "cron/cron-hermes-billing.sh": "cron-hermes-billing.sh",
    "cron/cron-hermes-health.sh": "cron-hermes-health.sh",
    "cron/cron-hermes-memory.sh": "cron-hermes-memory.sh",
    "cron/mnemosyne-health-monitor.sh": "mnemosyne-health-monitor.sh",
    "cron/tmt-consolidate.sh": "tmt-consolidate.sh"
  },
  "prod_config": [
    {
      "path": "scripts/backup.sh",
      "why": "生产版含真实备份目标路径，仓库版是模板；覆盖会打断备份"
    },
    {
      "path": "deploy/mnemosyne.service",
      "why": "仓库是模板（YOUR_USER//path/to），生产是实配 unit；覆盖会让服务起不来"
    },
    {
      "path": "cron/cron-hermes-billing.sh",
      "why": "生产实配：含真实账单路径/邮箱参数，仓库版是参考副本"
    },
    {
      "path": "cron/cron-hermes-health.sh",
      "why": "生产实配：探测的端口/路径是服务器实际值"
    },
    {
      "path": "cron/cron-hermes-memory.sh",
      "why": "生产实配：记忆巡检的库名/用户是服务器实际值"
    },
    {
      "path": "cron/tmt-consolidate.sh",
      "why": "生产实配：TMT 汇总的时间窗与路径为线上值"
    }
  ]
}